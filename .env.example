# Copy to .env. Git ignores .env. Do not paste values into chat.

# Gemini on Vertex. A service-account file is used when both GOOGLE_CLOUD_PROJECT and GOOGLE_APPLICATION_CREDENTIALS are set.
# Otherwise GOOGLE_API_KEY is sent in Vertex express mode.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Search
# BRAVE_SEARCH_API_KEY=
# BRAVE_MONTHLY_LIMIT=2000
# CURRENTS_API_KEY=
# GDELT_DAILY_MAX=8

# Microsoft Graph mail for daily RED alerts. The app needs Mail.Send (application) and admin consent.
# Leave these blank to keep alerts as drafts. GRIT_RED_MAIL_TO is the R&A duty team, comma-separated. Do not invent addresses.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAIL_SENDER=
# GRIT_RED_MAIL_TO=

# Sphera is not called. Put a licence in secrets/sphera.env when an API contract exists.
# That file holds SPHERA_API_URL and SPHERA_API_KEY.

# Dataverse (app-only)
# DATAVERSE_TENANT_ID=
# DATAVERSE_CLIENT_ID=
# DATAVERSE_CLIENT_SECRET=
# DATAVERSE_ORG_URL=

# Local files
# GRIT_WORKBOOK=secrets/URS_Entity_Info_20261006.xlsx
# GRIT_DB=output/grit.sqlite
