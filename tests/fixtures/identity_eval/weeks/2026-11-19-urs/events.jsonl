{"week_id": "2026-11-19-urs", "event_id": "EVT-324482df10b97b4b", "band": "▲", "score": 12, "tier": 1, "item": "US export controls on AI chips across five nations [Key Risk 5; Emerging Risk 2]", "lead": "SIG-001664f24a0781ad", "elevated": true, "near_elevated": false, "member_signal_ids": ["SIG-001664f24a0781ad", "SIG-38dec64c296f1d1d", "SIG-7fa8248ceb626daa"], "members": [{"signal_id": "SIG-001664f24a0781ad", "title": "US AI Chip Export Rule: 5 Countries, 90 Days", "text": "", "publisher": "shattered.io", "published_at": "17 Nov 2026, 02:27 UTC", "url": "https://shattered.io/us-ai-chip-rule-china-remote-access-five-countries-90-day-deadline", "tier": 1, "source_band": "UNRATED", "rung": null, "lane": "", "red": null, "red_status": null, "editorial": {"decision": "INCLUDE", "source_ids": ["SIG-001664f24a0781ad", "SIG-38dec64c296f1d1d", "SIG-7fa8248ceb626daa"], "immediate_threat": true, "significance": 12, "risk_ids": []}}, {"signal_id": "SIG-38dec64c296f1d1d", "title": "WSJ: US imposes chip export licenses on 5 countries to close China’s data center loophole", "text": "", "publisher": "investinglive.com", "published_at": "17 Nov 2026, 01:23 UTC", "url": "https://investinglive.com/news/wsj-us-imposes-chip-export-licenses-on-5-countries-to-close-china-s-data-center-loophole", "tier": 1, "source_band": "UNRATED", "rung": null, "lane": "", "red": null, "red_status": null, "editorial": {"decision": "INCLUDE", "source_ids": ["SIG-001664f24a0781ad", "SIG-38dec64c296f1d1d", "SIG-7fa8248ceb626daa"], "immediate_threat": true, "significance": 12, "risk_ids": []}}, {"signal_id": "SIG-7fa8248ceb626daa", "title": "US tightens AI chip export curbs to close China’s overseas data centre loophole", "text": "", "publisher": "scmp.com", "published_at": "16 Nov 2026, 15:46 UTC", "url": "https://scmp.com/tech/article/3374639/us-tightens-ai-chip-export-curbs-close-chinas-overseas-data-centre-loophole", "tier": 1, "source_band": "UNRATED", "rung": null, "lane": "", "red": null, "red_status": null, "editorial": {"decision": "INCLUDE", "source_ids": ["SIG-001664f24a0781ad", "SIG-38dec64c296f1d1d", "SIG-7fa8248ceb626daa"], "immediate_threat": true, "significance": 12, "risk_ids": []}}], "section": "register_risk", "mf_theme": "", "risk_tag": "Key Risk 5; Emerging Risk 2", "summary": "On 16 November 2026, the US Bureau of Industry and Security announced restrictions on Chinese companies' remote access to advanced US artificial intelligence chips hosted in overseas data centres (scmp.com, 16 Nov 2026 [S30]). On 17 November 2026, the US Commerce Department mandated export licenses for shipping advanced chips to facilities in Singapore, Thailand, Malaysia, Indonesia, and Brazil, giving operators a 90-day deadline to comply (shattered.io, 17 Nov 2026 [S31]; investinglive.com, 17 "}
